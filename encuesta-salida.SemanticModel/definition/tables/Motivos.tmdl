				    #"Dividir columna por delimitador" = Table.ExpandListColumn(Table.TransformColumns(#"Columnas con nombre cambiado", {{"Motivo", Splitter.SplitTextByDelimiter(", ", QuoteStyle.Csv), let itemType = (type nullable text) meta [Serialized.Text = true] in type {itemType}}}), "Motivo"),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Dividir columna por delimitador",{{"Motivo", type text}}),
				    #"Texto recortado" = Table.TransformColumns(#"Tipo cambiado",{{"Motivo", Text.Trim, type text}}),
				    #"Valor reemplazado" = Table.ReplaceValue(#"Texto recortado",".","",Replacer.ReplaceText,{"Motivo"}),
				    #"Columna condicional agregada" = Table.AddColumn(#"Valor reemplazado", "Tipo de salida", each if [Motivo] = "Faltas injustificadas" then "Involuntaria" else if [Motivo] = "Intoxicación etílica en horario laboral" then "Involuntaria" else if [Motivo] = "Falta de respeto a un cliente" then "Involuntaria" else if [Motivo] = "Falta de respeto hacia mis compañeros" then "Involuntaria" else "Voluntaria")
				in
